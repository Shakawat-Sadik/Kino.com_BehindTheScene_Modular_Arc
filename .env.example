# ─────────────────────────────────────────────────────────────
# Kino.com Server — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
# Render injects PORT automatically in production; app binds 0.0.0.0:$PORT.
PORT=5000

# MongoDB connection string (Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Kino

# Upstash Redis (RESP/TCP over TLS). Example: rediss://default:<token>@<host>:<port>
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# Frontend origin — used for CORS and to fetch the JWKS at ${CLIENT_URL}/api/auth/jwks
CLIENT_URL=http://localhost:3000

# Stripe (server-side secret key)
STRIPE_SECRET_KEY=sk_test_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
